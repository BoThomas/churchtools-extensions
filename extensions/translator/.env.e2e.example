# =============================================================================
# E2E Test Configuration - Copy this to .env.e2e and fill in values
# .env.e2e is automatically loaded when running: pnpm test:e2e
# =============================================================================

# IMPORTANT: Playwright automatically starts a dev server on port 5163
# You don't need to manually start the dev server - just run: pnpm test:e2e

# Extension key for E2E tests (isolates test data from dev/prod)
VITE_KEY=translator-e2e-test

# ChurchTools test instance URL
VITE_EXTERNAL_API_URL=https://testinstance.church.tools/

# Mock Azure SDK in E2E tests (app checks this flag)
VITE_USE_MOCK_AZURE=true

# E2E test user credentials (for authenticating in tests)
VITE_USERNAME=e2e-test
VITE_PASSWORD=your-e2e-password-here

# E2E dev server port (dedicated port for E2E tests)
VITE_PORT=5163

# API base URL
VITE_API_BASE_URL=/
